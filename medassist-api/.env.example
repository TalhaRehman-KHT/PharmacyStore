# Runtime environment: dev or prod
APP_ENV=dev
# Version reported by /health and Swagger
APP_VERSION=0.1.0

# Supabase project URL (Project Settings > API) - required
SUPABASE_URL=
# Supabase service role key, server side only, never sent to the client - required
SUPABASE_SERVICE_KEY=
# Supabase JWT secret for verifying user tokens (optional until step 2.3)
SUPABASE_JWT_SECRET=
# app_user_id (default: trust the X-User-Id header, see docs/ARCHITECTURE.md section 4) or supabase (JWT)
AUTH_MODE=app_user_id
# Staff roles (JSON lists): all-access roles see every escalation; vendor roles see their own pharmacies + general
STAFF_ALL_ACCESS_ROLES=["admin","doctor"]
STAFF_VENDOR_ROLES=["vendor"]
# dev scripts only (schema snapshot). The API never uses it at runtime. Supabase > Connect > Session pooler
DATABASE_URL=
# Supabase anon key: optional, integration tests only (checks the browser key cannot reach private data)
SUPABASE_ANON_KEY=

# Groq API key, primary LLM - required
GROQ_API_KEY=
# Gemini API key, embeddings and fallback LLM - required
GEMINI_API_KEY=
# openFDA API key, raises the download rate limit (optional)
OPENFDA_API_KEY=
# LangSmith API key for tracing (optional)
LANGSMITH_API_KEY=

# Groq model for fast steps (guard, router, rewrite, grade); ids from GET /openai/v1/models
GROQ_FAST_MODEL=openai/gpt-oss-20b
# Groq model that writes the final answer
GROQ_ANSWER_MODEL=qwen/qwen3.8-27b
# Groq model tried when the main model is busy (its own free token bucket)
GROQ_BACKUP_MODEL=openai/gpt-oss-20b
# Gemini embedding model (all chunks and queries must use the same one; see embed-status)
GEMINI_EMBED_MODEL=gemini-embedding-001
# Gemini model used when both Groq models are rate-limited (429), time out or fail
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# Embedding size; must match the vector column in SQL
EMBED_DIM=768

# Retrieval: vector (best in the S4 measurement) or hybrid; RERANK_ENABLED=true adds FlashRank
RETRIEVAL_MODE=vector
RERANK_ENABLED=false
RERANK_MODEL=ms-marco-MiniLM-L-12-v2

# Currency code of the shop prices on product cards (default USD: the shop shows "$")
SHOP_CURRENCY=

# Allowed browser origins, JSON list
CORS_ORIGINS=["http://localhost:5173"]
# Per-user request limit (slowapi syntax)
RATE_LIMIT=20/hour
