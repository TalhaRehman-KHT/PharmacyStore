# Runtime environment: dev or prod
APP_ENV=dev
# Version reported by /health and Swagger
APP_VERSION=0.1.0

# Supabase project URL (Project Settings > API) - required
SUPABASE_URL=
# Supabase service role key, server side only, never sent to the client - required
SUPABASE_SERVICE_KEY=
# Supabase JWT secret for verifying user tokens (optional until step 2.3)
SUPABASE_JWT_SECRET=
# dev scripts only (schema snapshot). The API never uses it at runtime. Supabase > Connect > Session pooler
DATABASE_URL=

# Groq API key, primary LLM - required
GROQ_API_KEY=
# Gemini API key, embeddings and fallback LLM - required
GEMINI_API_KEY=
# openFDA API key, raises the download rate limit (optional)
OPENFDA_API_KEY=
# LangSmith API key for tracing (optional)
LANGSMITH_API_KEY=

# Groq model for fast steps (guard, router, rewrite, grade)
GROQ_FAST_MODEL=llama-3.1-8b-instant
# Groq model that writes the final answer
GROQ_ANSWER_MODEL=llama-3.3-70b-versatile
# Gemini embedding model
GEMINI_EMBED_MODEL=text-embedding-004
# Gemini model used when Groq fails
GEMINI_FALLBACK_MODEL=gemini-2.0-flash
# Embedding size; must match the vector column in SQL
EMBED_DIM=768

# Allowed browser origins, JSON list
CORS_ORIGINS=["http://localhost:5173"]
# Per-user request limit (slowapi syntax)
RATE_LIMIT=20/hour
