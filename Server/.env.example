PORT=5050

# Supabase (service role — server only; never expose to the client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Vercel: add the same two keys (plus Stripe below) under
# Project → Settings → Environment Variables.
# Use "Production" (and "Preview" if you test preview URLs). Redeploy after saving.

# Stripe (Dashboard → Developers → API keys). Money settles in this account (platform / admin).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: comma-separated origins for CORS (defaults to permissive in dev)
# FRONTEND_URL=http://localhost:5173,https://your-app.vercel.app

# Checkout currency (lowercase ISO code)
STRIPE_CURRENCY=usd
