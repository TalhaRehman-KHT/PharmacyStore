# ==============================================================
# PharmacyStore — .gitignore
# ==============================================================

# ---------- Secrets / environment ----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
service-account*.json
credentials*.json

# ---------- Dependencies ----------
node_modules/
.pnpm-store/
.yarn/
.npm/

# ---------- Build output ----------
dist/
dist-ssr/
build/
out/
.vite/
*.tsbuildinfo

# ---------- Deploy / platform ----------
.vercel/
.netlify/
.supabase/
supabase/.temp/

# ---------- Tests / coverage ----------
coverage/
.nyc_output/
playwright-report/
test-results/

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- AI assistant / local notes (never published) ----------
CLAUDE.md
CLAUDE.local.md
.claude/
.cursor/
.aider*
docs/
*.md
!README.md

# ---------- Editors ----------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# ---------- OS ----------
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# ---------- Office temp / lock files ----------
~$*
*.tmp
