# Client env (Vite). Only VITE_* names are exposed to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=
VITE_GOOGLE_WEB_CLIENT_ID=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_GEMINI_API_KEY=

# MedAssist (FastAPI). Mock is used unless USE_MOCK is exactly "false".
VITE_MEDASSIST_API_URL=
VITE_MEDASSIST_USE_MOCK=true
